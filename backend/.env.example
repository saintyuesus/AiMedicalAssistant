# ===== 大模型配置（阿里云百炼 · 通义千问，OpenAI 兼容协议）=====
# 申请地址: https://bailian.console.aliyun.com/?apiKey=1
# 复制本文件为 .env 并填入你的 API Key
DASHSCOPE_API_KEY=sk-在这里填入你的APIKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 文本对话模型（可选: qwen-plus / qwen-turbo / qwen-max）
LLM_CHAT_MODEL=qwen-plus
# 多模态视觉模型（图片/化验单/药盒识别）
LLM_VISION_MODEL=qwen-vl-max

# 服务端口
PORT=8000
